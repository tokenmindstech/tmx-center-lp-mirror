{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/TMX Center Home.dc.html" },
    { "source": "/visibility", "destination": "/TMX Visibility.dc.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.dc\\.html",
      "headers": [{ "key": "Content-Type", "value": "text/html; charset=utf-8" }]
    }
  ]
}
